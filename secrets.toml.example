# Copie este arquivo para "secrets.toml" (mesma pasta) para testar localmente,
# OU cole este conteúdo em Streamlit Cloud > Settings > Secrets (nunca suba o
# secrets.toml de verdade pro GitHub).
#
# Onde encontrar esses valores no Supabase:
#   Project Settings > API > Project URL          -> SUPABASE_URL
#   Project Settings > API > Project API keys > anon public -> SUPABASE_ANON_KEY

SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_ANON_KEY = "sua-chave-anon-aqui"
